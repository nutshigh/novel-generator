{
  "name": "@novelbuilder/agent-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pi": "node --env-file-if-exists=.env --import tsx scripts/check-pi-api.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "generate": "node --env-file-if-exists=.env --import tsx src/generate.ts",
    "serve": "node --env-file-if-exists=.env --import tsx src/server.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "cytoscape": "^3.34.4",
    "neo4j-driver": "^5.28.3",
    "typebox": "1.3.27",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
